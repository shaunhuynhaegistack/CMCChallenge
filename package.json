{
  "name": "orangehrm-qa-automation",
  "version": "1.0.0",
  "description": "End-to-end automation framework for the OrangeHRM employee lifecycle, built with Playwright and Cucumber (BDD).",
  "private": true,
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "scripts": {
    "test": "ts-node tools/run-suite.ts chromium",
    "test:all": "npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:chromium": "ts-node tools/run-suite.ts chromium",
    "test:firefox": "ts-node tools/run-suite.ts firefox",
    "test:webkit": "ts-node tools/run-suite.ts webkit",
    "test:smoke": "ts-node tools/run-suite.ts chromium --tags @smoke",
    "test:regression": "ts-node tools/run-suite.ts chromium --tags @regression",
    "test:retry": "cross-env RETRY=2 ts-node tools/run-suite.ts chromium",
    "test:headed": "cross-env HEADLESS=false SLOW_MO=250 WORKERS=1 ts-node tools/run-suite.ts chromium",
    "test:failure-demo": "ts-node tools/run-suite.ts showcase",
    "test:unit": "node --test --require ts-node/register lib/unit/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:tags && npm run check:guardrails && npm run test:unit",
    "check:target": "ts-node tools/check-target.ts",
    "report": "ts-node config/report/generate-html-report.ts",
    "report:open": "ts-node tools/open-report.ts",
    "report:zip": "ts-node tools/zip-report.ts",
    "flaky:check": "ts-node tools/flaky-detector.ts",
    "notify": "ts-node tools/notify.ts",
    "notify:dry-run": "ts-node tools/notify.ts --dry-run",
    "perf": "npm run perf:login && npm run perf:employee && npm run perf:search && npm run perf:lifecycle",
    "perf:smoke": "cross-env PERF_PROFILE=smoke npm run perf",
    "perf:login": "node -e \"require('fs').mkdirSync('performance/results',{recursive:true})\" && k6 run --log-format=raw performance/scenarios/login.ts",
    "perf:employee": "node -e \"require('fs').mkdirSync('performance/results',{recursive:true})\" && k6 run --log-format=raw performance/scenarios/employee-create.ts",
    "perf:search": "node -e \"require('fs').mkdirSync('performance/results',{recursive:true})\" && k6 run --log-format=raw performance/scenarios/employee-search.ts",
    "perf:lifecycle": "node -e \"require('fs').mkdirSync('performance/results',{recursive:true})\" && k6 run --log-format=raw performance/scenarios/employee-lifecycle.ts",
    "perf:summary": "ts-node tools/summarise-performance.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "check:tags": "ts-node tools/check-tags.ts",
    "check:guardrails": "ts-node tools/check-guardrails.ts",
    "format": "prettier --write \"**/*.{ts,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yaml}\"",
    "install:browsers": "playwright install --with-deps chromium firefox webkit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p performance/tsconfig.json"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "orangehrm",
    "automation"
  ],
  "author": "shaunhuynhaegistack",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^6.0.4",
    "@types/k6": "^2.2.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "always"
  }
}
