# Copy to .env and adjust. .env is git ignored.

# Which file under config/environments is used as the base layer.
ENV=demo

# Overrides - anything left blank falls back to the environment file.
BASE_URL=
BROWSER=chromium
HEADLESS=true
WORKERS=3
RETRY=0
SLOW_MO=0

# Credentials. The public demo credentials are committed as fixture defaults;
# any real environment should set these instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ESS_PASSWORD=

# Optional - report notifications (see the Reporting section of the README).
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
