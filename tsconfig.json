{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": false,
    "files": true
  },
  "include": ["**/*.ts", "types/**/*.d.ts", ".github/scripts/**/*.ts"],
  "exclude": ["node_modules", "reports", "performance", "docs"]
}
